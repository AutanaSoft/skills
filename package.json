{
  "name": "skills",
  "version": "1.0.0",
  "private": true,
  "description": "Public collection of AutanaSoft skills for AI agents.",
  "license": "MIT",
  "author": {
    "name": "AutanaSoft",
    "url": "https://github.com/AutanaSoft"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AutanaSoft/skills.git"
  },
  "bugs": {
    "url": "https://github.com/AutanaSoft/skills/issues"
  },
  "homepage": "https://github.com/AutanaSoft/skills#readme",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "typescript",
    "nestjs",
    "nextjs",
    "zod",
    "drizzle",
    "workflow"
  ],
  "scripts": {
    "validate": "bash scripts/validate.sh",
    "format:all": "pnpm format && pnpm lint:markdown",
    "format": "prettier --write README.md AGENTS.md \"{docs,skills}/**/*.md\"",
    "format:check": "prettier --check README.md AGENTS.md \"{docs,skills}/**/*.md\"",
    "lint:markdown": "markdownlint-cli2 README.md AGENTS.md \"{docs,skills}/**/*.md\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.2.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6"
  }
}
